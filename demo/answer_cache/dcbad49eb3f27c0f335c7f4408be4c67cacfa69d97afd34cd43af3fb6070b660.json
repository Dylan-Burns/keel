chives/edgar/data/1744489/000174448924000152/dis-20240330.htm", "truncated": false}, {"chunk_id": "DIS_10Q_2024-03-30__financial_statements__0032", "ticker": "DIS", "form": "10-Q", "fiscal_label": "Q2 FY2024", "period_end": "2024-03-30", "section": "financial_statements", "score": 0.197, "filing_name": "The Walt Disney Company 10-Q Q2 FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/1744489/000174448924000152/dis-20240330.htm", "truncated": false}, {"chunk_id": "DIS_10Q_2023-12-30__mdna__0077", "ticker": "DIS", "form": "10-Q", "fiscal_label": "Q1 FY2024", "period_end": "2023-12-30", "section": "mdna", "score": 0.7907, "filing_name": "The Walt Disney Company 10-Q Q1 FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/1744489/000174448924000081/dis-20231230.htm", "truncated": false}, {"chunk_id": "DIS_10Q_2023-12-30__mdna__0010", "ticker": "DIS", "form": "10-Q", "fiscal_label": "Q1 FY2024", "period_end": "2023-12-30", "section": "mdna", "score": 0.514, "filing_name": "The Walt Disney Company 10-Q Q1 FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/1744489/000174448924000081/dis-20231230.htm", "truncated": false}, {"chunk_id": "DIS_10Q_2023-12-30__mdna__0023", "ticker": "DIS", "form": "10-Q", "fiscal_label": "Q1 FY2024", "period_end": "2023-12-30", "section": "mdna", "score": 0.2407, "filing_name": "The Walt Disney Company 10-Q Q1 FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/1744489/000174448924000081/dis-20231230.htm", "truncated": false}, {"chunk_id": "DIS_10Q_2023-12-30__mdna__0101", "ticker": "DIS", "form": "10-Q", "fiscal_label": "Q1 FY2024", "period_end": "2023-12-30", "section": "mdna", "score": 0.1758, "filing_name": "The Walt Disney Company 10-Q Q1 FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/1744489/000174448924000081/dis-20231230.htm", "truncated": false}], "collapsed_near_duplicates": 22, "dropped_candidates": 125, "token_estimate": 17220, "gaps": [], "degraded": []}, "answer": {"direct_answer": "Disney's fiscal 2024 (ended September 28, 2024) revenues rose 3%, or $2.5 billion, to $91.4 billion, and diluted EPS from continuing operations attributable to Disney rose to $2.72 from $1.29, which the filing attributes to higher operating income at Entertainment [DIS_10K_2024-09-28__mdna__0003]. Service revenues grew due to higher subscription revenue, growth at parks and experiences businesses, and to a lesser extent higher advertising revenue, partly offset by lower theatrical distribution, TV/VOD distribution and affiliate revenue [DIS_10K_2024-09-28__mdna__0003]. Direct-to-Consumer swung to operating income of $143 million from a loss of $2,496 million, on subscription fees of $18,796 million versus $16,420 million [DIS_10K_2024-09-28__mdna__0035]. Linear Networks operating income fell 16% to $3,452 million from $4,119 million, with affiliate fees and advertising both lower [DIS_10K_2024-09-28__mdna__0025]. Experiences revenue grew 5% to $34,151 million [DIS_10K_2024-09-28__mdna__0019], and total segment operating income rose to $15,601 million from $12,863 million [DIS_10K_2024-09-28__financial_statements__0029].", "company_findings": [{"ticker": "DIS", "company": "The Walt Disney Company", "findings": [{"point": "Direct-to-Consumer was the main swing factor: fiscal 2024 operating income was $143 million versus a loss of $2,496 million in fiscal 2023, with subscription fees up 14% to $18,796 million.", "citations": ["DIS_10K_2024-09-28__mdna__0035"], "unverified": false}, {"point": "Linear Networks weakened: operating income fell 16% to $3,452 million, with affiliate fees down 7% to $6,872 million and advertising down 12% to $3,676 million.", "citations": ["DIS_10K_2024-09-28__mdna__0025"], "unverified": false}, {"point": "Experiences revenue rose 5% to $34,151 million and segment operating income rose to $9,272 million from $8,954 million, while Sports operating income was $2,406 million versus $2,465 million.", "citations": ["DIS_10K_2024-09-28__mdna__0019", "DIS_10K_2024-09-28__financial_statements__0029"], "unverified": false}]}], "comparison_table": {"columns": ["Segment", "Revenue fiscal 2024 ($ millions)", "Revenue fiscal 2023 ($ millions)", "Operating income fiscal 2024 ($ millions)", "Operating income fiscal 2023 ($ millions)"], "rows": [["Entertainment", "41,186 [DIS_10K_2024-09-28__financial_statements__0029]", "40,635", "3,923", "1,444"], ["Sports", "17,619 [DIS_10K_2024-09-28__financial_statements__0029]", "17,111", "2,406", "2,465"], ["Experiences", "34,151 [DIS_10K_2024-09-28__financial_statements__0029]", "32,549", "9,272", "8,954"]]}, "citations": [{"chunk_id": "DIS_10K_2024-09-28__mdna__0003", "claim": "Fiscal 2024 revenue, EPS and service revenue drivers", "quote": "Revenues for fiscal 2024 increased 3%, or $2.5 billion, to $91.4 billion"}, {"chunk_id": "DIS_10K_2024-09-28__mdna__0035", "claim": "DTC swung to operating income on subscription growth", "quote": "Subscription fees | $ 18,796 | $ 16,420 | 14 %"}, {"chunk_id": "DIS_10K_2024-09-28__mdna__0025", "claim": "Linear Networks revenue and operating income declined", "quote": "Operating Income | $ 3,452 | $ 4,119 | (16) %"}, {"chunk_id": "DIS_10K_2024-09-28__mdna__0019", "claim": "Segment revenue growth, Experiences up 5%", "quote": "Experiences | 34,151 | 32,549 | 5 %"}, {"chunk_id": "DIS_10K_2024-09-28__financial_statements__0029", "claim": "Segment operating income by segment", "quote": "Total segment operating income(1) | $ 15,601 | $ 12,863 | $ 12,121"}], "coverage": {"companies_used": [{"ticker": "DIS", "forms": ["10-K"], "fiscal_periods": ["fiscal 2024, ended September 28, 2024"]}], "companies_missing": [], "data_as_of": "10-K filed 2024-11-14 for fiscal 2024, ended September 28, 2024"}, "gaps": ["The retrieved chunks do not include the narrative explanation of Experiences or Sports operating income changes, such as attendance, pricing or sports rights costs.", "Disney's reasons for the Linear Networks decline beyond the reported revenue