_id": "GS_10K_2024-12-31__risk_factors__0116", "ticker": "GS", "form": "10-K", "fiscal_label": "FY2024", "period_end": "2024-12-31", "section": "risk_factors", "score": 0.9276, "filing_name": "Goldman Sachs Group Inc 10-K FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/886982/000088698225000005/gs-20241231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__risk_factors__0001", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "risk_factors", "score": 1.4372, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__risk_factors__0000", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "risk_factors", "score": 1.1001, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__mdna__0225", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "mdna", "score": 0.9882, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__mdna__0227", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "mdna", "score": 0.9275, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__mdna__0158", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "mdna", "score": 0.8292, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__mdna__0507", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "mdna", "score": 0.7296, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__unknown__0075", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "unknown", "score": 0.6698, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__mdna__0336", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "mdna", "score": 0.5424, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__mdna__0264", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "mdna", "score": 0.5271, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__mdna__0242", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "mdna", "score": 0.439, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__mdna__0235", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "mdna", "score": 0.3149, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}], "collapsed_near_duplicates": 61, "dropped_candidates": 615, "token_estimate": 31970, "gaps": [], "degraded": []}, "answer": {"direct_answer": "All four banks describe interest rate risk as affecting earnings, funding and asset values, but they differ in emphasis. JPMorgan (fiscal 2025, ended December 31, 2025) expects higher net interest income when rates are high or rising, but lists offsetting risks such as deposit loss, AFS securities losses and higher funding costs [JPM_10K_2025-12-31__risk_factors__0028]. Bank of America (fiscal 2024, ended December 31, 2024) says lower rates would typically reduce net interest income, while higher rates can reduce AFS fair values and hurt capital and liquidity [BAC_10K_2024-12-31__risk_factors__0003] [BAC_10K_2024-12-31__risk_factors__0009]. Morgan Stanley (fiscal 2025, ended December 31, 2025) says its net interest income is sensitive to rates and describes the Wealth Management balance sheet as asset sensitive [MS_10K_2025-12-31__unknown__0075] [MS_10K_2025-12-31__mdna__0242]. Goldman Sachs (fiscal 2024, ended December 31, 2024) has chunks on debt-ceiling-driven rate increases and credit spreads, but none in the context that describe interest rate risk as a stand-alone risk factor [GS_10K_2024-12-31__risk_factors__0011] [GS_10K_2024-12-31__risk_factors__0024].", "company_findings": [{"ticker": "JPM", "company": "JPMorgan Chase & Co", "findings": [{"point": "JPMorgan may generally be expected to earn higher net interest income when interest rates are high or increasing.", "citations": ["JPM_10K_2025-12-31__risk_factors__0028"], "unverified": false}, {"point": "Higher rates could also cause fewer real estate loan originations, deposit loss, losses on AFS securities, less market liquidity and higher funding costs, and could hurt variable-rate borrowers' payment performance.", "citations": ["JPM_10K_2025-12-31__risk_factors__0028"], "unverified": false}, {"point": "A low or negative rate environment could compress net interest margins, change depositor behavior and reduce the value of the mortgage servicing rights asset.", "citations": ["JPM_10K_2025-12-31__risk_factors__0028"], "unverified": false}]}, {"ticker": "BAC", "company": "Bank of America Corporation", "findings": [{"point": "Lower interest rates from any Federal Reserve policy change would typically result in lower revenue through lower net interest income.", "citations": ["BAC_10K_2024-12-31__risk_factors__0003"], "unverified": false}, {"point": "Higher rates have generally helped net interest income but have negatively affected investment securities, deposits, loan demand and funding costs.", "citations": ["BAC_10K_2024-12-31__risk_factors__0003"], "unverified": false}, {"point": "Rate increases or spread changes can reduce the fair value of AFS debt securities, which hurts accumulated other comprehensive income, capital and regulatory liquidity, and can reduce mortgage originations.", "citations": ["BAC_10K_2024-12-31__risk_factors__0009"], "unverified": false}]}, {"ticker": "GS", "company": "Goldman Sachs Group Inc", "findings": [{"point": "A U.S. default over the debt ceiling could lead to further increases in interest rates and borrowing costs.", "citations": ["GS_10K_2024-12-31__risk_factors__0011"], "unverified": false}, {"point": "Goldman ties its long-term unsecured funding cost directly to its credit spreads, which are market-driven and can move unpredictably.", "citations": ["GS_10K_2024-12-31__risk_factors__0024"], "unverified": false}]}, {"ticker": "MS", "company": "Morgan Stanley", "findings": [{"point": "Net interest income generally rises in higher rate scenarios and falls in lower rate scenarios, and the pace of rate changes has affected deposit mix, interest expense and loan demand.", "citations": ["MS_10K_2025-12-31__unknown__0075"], "unverified": false}, {"point": "The Wealth Management balance sheet is asset sensitive because assets reprice faster than liabilities, and Morgan Stanley manages net interest income across a range of outcomes rather than to a single rate scenario.", "citations": ["MS_10K_2025-12-31__mdna__0242"], "unverified": false}, {"point": "Trading interest rate and credit spread risk arises from market-making in rate-sensitive instruments, and non-trading interest rate risk arises in the banking book.", "citations": ["MS_10K_2025-12-31__mdna__0227", "MS_10K_2025-12-31__mdna__0225"], "unverified": false}]}], "comparison_table": {"columns": ["Company (fiscal period)", "Effect of higher rates", "Effect of lower rates", "Other rate-related themes"], "rows": [["JPM (fiscal 2025, ended Dec 31, 2025)", "Generally higher NII, but deposit loss and AFS losses [JPM_10K_2025-12-31__risk_factors__0028]", "Compressed margins, lower MSR value [JPM_10K_2025-12-31__risk_factors__0028]", "Variable-rate borrower payment stress [JPM_10K_2025-12-31__risk_factors__0028]"], ["BAC (fiscal 2024, ended Dec 31, 2024)", "NII positive, but securities, deposits, funding hurt [BAC_10K_2024-12-31__risk_factors__0003]", "Typically lower NII and revenue [BAC_10K_2024-12-31__risk_factors__0003]", "AFS fair value hits capital and liquidity [BAC_10K_2024-12-31__risk_factors__0009]"], ["MS (fiscal 2025, ended Dec 31, 2025)", "Higher NII generally [MS_10K_2025-12-31__unknown__0075]", "Lower NII generally [MS_10K_2025-12-31__unknown__0075]", "Asset-sensitive Wealth Management balance sheet [MS_10K_2025-12-31__mdna__0242]"], ["GS (fiscal 2024, ended Dec 31, 2024)", "Debt-ceiling default could further increase rates [GS_10K_2024-12-31__risk_factors__0011]", "Not stated in the context chunks", "Credit spreads drive unsecured funding cost [GS_10K_2024-12-31__risk_factors__0024]"]]}, "citations": [{"chunk_id": "JPM_10K_2025-12-31__risk_factors__0028", "claim": "JPM rate effects", "quote": "may generally be expected to earn higher net interest income when interest rates are high or increasing"}, {"chunk_id": "BAC_10K_2024-12-31__risk_factors__0003", "claim": "BAC lower rates reduce NII", "quote": "resulting in lower interest rates would typically result in lower revenue through lower net interest income"}, {"chunk_id": "BAC_10K_2024-12-31__risk_factors__0009", "claim": "BAC AFS securities, capital and liquidity", "quote": "increases in interest rates or changes in spreads may continue to adversely impact the fair value of our debt securities"}, {"chunk_id": "GS_10K_2024-12-31__risk_factors__0011", "claim": "GS debt-ceiling rate risk", "quote": "further increases in interest rates and borrowing costs and a recession"}, {"chunk_id": "GS_10K_2024-12-31__risk_factors__0024", "claim": "GS credit spreads and funding cost", "quote": "Our cost of obtaining long-term unsecured funding is directly related to our credit spreads"}, {"chunk_id": "MS_10K_2025-12-31__unknown__0075", "claim": "MS NII rate sensitivity", "quote": "Our net interest income is sensitive to changes in interest rates"}, {"chunk_id": "MS_10K_2025-12-31__mdna__0242", "claim": "MS asset-sensitive Wealth Management", "quote": "Our Wealth Management business segment balance sheet is asset sensitive, given assets reprice faster than liabilities"}, {"chunk_id": "MS_10K_2025-12-31__mdna__0227", "claim": "MS trading rate risk", "quote": "We are exposed to interest rate and credit spread risk as a result of our market-making activities"}, {"chunk_id": "MS_10K_2025-12-31__mdna__0225", "claim": "MS non-trading rate risk", "quote": "Non-trading interest rate risk in the banking book"}], "coverage": {"companies_used": [{"ticker": "JPM", "forms": ["10-K"], "fiscal_periods": ["fiscal 2025, ended December 31, 2025"]}, {"ticker": "BAC", "forms": ["10-K"], "fiscal_periods": ["fiscal 2024, ended December 31, 2024"]}, {"ticker": "GS", "forms": ["10-K"], "fiscal_periods": ["fiscal 2024, ended December 31, 2024"]}, {"ticker": "MS", "forms": ["10-K"], "fiscal_periods": ["fiscal 2025, ended December 31, 2025"]}], "companies_missing": [], "data_as_of": "Latest filing in context: Morgan Stanley 10-K filed 2