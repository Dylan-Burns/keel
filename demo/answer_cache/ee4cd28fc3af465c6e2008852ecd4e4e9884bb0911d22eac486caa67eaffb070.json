/1744489/000174448924000152/dis-20240330.htm", "truncated": false}, {"chunk_id": "DIS_10Q_2024-03-30__financial_statements__0032", "ticker": "DIS", "form": "10-Q", "fiscal_label": "Q2 FY2024", "period_end": "2024-03-30", "section": "financial_statements", "score": 0.197, "filing_name": "The Walt Disney Company 10-Q Q2 FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/1744489/000174448924000152/dis-20240330.htm", "truncated": false}, {"chunk_id": "DIS_10Q_2023-12-30__mdna__0077", "ticker": "DIS", "form": "10-Q", "fiscal_label": "Q1 FY2024", "period_end": "2023-12-30", "section": "mdna", "score": 0.7907, "filing_name": "The Walt Disney Company 10-Q Q1 FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/1744489/000174448924000081/dis-20231230.htm", "truncated": false}, {"chunk_id": "DIS_10Q_2023-12-30__mdna__0010", "ticker": "DIS", "form": "10-Q", "fiscal_label": "Q1 FY2024", "period_end": "2023-12-30", "section": "mdna", "score": 0.514, "filing_name": "The Walt Disney Company 10-Q Q1 FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/1744489/000174448924000081/dis-20231230.htm", "truncated": false}, {"chunk_id": "DIS_10Q_2023-12-30__mdna__0023", "ticker": "DIS", "form": "10-Q", "fiscal_label": "Q1 FY2024", "period_end": "2023-12-30", "section": "mdna", "score": 0.2407, "filing_name": "The Walt Disney Company 10-Q Q1 FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/1744489/000174448924000081/dis-20231230.htm", "truncated": false}, {"chunk_id": "DIS_10Q_2023-12-30__mdna__0101", "ticker": "DIS", "form": "10-Q", "fiscal_label": "Q1 FY2024", "period_end": "2023-12-30", "section": "mdna", "score": 0.1758, "filing_name": "The Walt Disney Company 10-Q Q1 FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/1744489/000174448924000081/dis-20231230.htm", "truncated": false}], "collapsed_near_duplicates": 22, "dropped_candidates": 125, "token_estimate": 19147, "gaps": [], "degraded": []}, "answer": {"direct_answer": "For fiscal 2024, ended September 28, 2024, Disney's revenues rose 3%, or $2.5 billion, to $91.4 billion, and diluted EPS from continuing operations attributable to Disney increased to $2.72 from $1.29 in fiscal 2023, ended September 30, 2023 [DIS_10K_2024-09-28__mdna__0003]. The EPS increase was attributed to higher operating income at Entertainment, where Direct-to-Consumer swung to operating income of $143 million from a loss of $2,496 million [DIS_10K_2024-09-28__mdna__0023]. Experiences was the largest profit contributor, with segment operating income of $9,272 million versus $8,954 million in fiscal 2023, ended September 30, 2023 [DIS_10K_2024-09-28__financial_statements__0029]. Linear Networks was a drag, with operating income down 16% to $3,452 million on lower affiliate fees and advertising [DIS_10K_2024-09-28__mdna__0025]. Lower impairment and restructuring charges and lower TFCF and Hulu acquisition amortization also affected results [DIS_10K_2024-09-28__mdna__0014].", "company_findings": [{"ticker": "DIS", "company": "The Walt Disney Company", "findings": [{"point": "Direct-to-Consumer revenues grew 15% to $22,776 million in fiscal 2024, ended September 28, 2024, led by subscription fees of $18,796 million, and operating income was $143 million versus a loss of $2,496 million in fiscal 2023, ended September 30, 2023.", "citations": ["DIS_10K_2024-09-28__mdna__0035"], "unverified": false}, {"point": "Experiences revenues rose 5% to $34,151 million and segment operating income was $9,272 million, up from $8,954 million in fiscal 2023, ended September 30, 2023.", "citations": ["DIS_10K_2024-09-28__mdna__0019", "DIS_10K_2024-09-28__financial_statements__0029"], "unverified": false}, {"point": "Linear Networks revenues fell 9% to $10,692 million, with affiliate fees down 7% and advertising down 12%, and operating income fell 16% to $3,452 million; Content Sales/Licensing and Other revenues fell 15% but operating income improved to $328 million from a loss of $179 million.", "citations": ["DIS_10K_2024-09-28__mdna__0025", "DIS_10K_2024-09-28__mdna__0023"], "unverified": false}, {"point": "Restructuring and impairment charges were $3,595 million in fiscal 2024 versus $3,892 million in fiscal 2023, and TFCF and Hulu acquisition amortization was $1,677 million versus $1,998 million.", "citations": ["DIS_10K_2024-09-28__mdna__0014"], "unverified": false}, {"point": "Fiscal 2024 charges included $1,287 million of goodwill impairments related to general entertainment linear networks.", "citations": ["DIS_10K_2024-09-28__mdna__0048"], "unverified": false}]}], "comparison_table": {"columns": ["Segment", "Revenues fiscal 2024 ($ millions)", "Operating income fiscal 2024 ($ millions)"], "rows": [["Entertainment", "41,186 [DIS_10K_2024-09-28__financial_statements__0029]", "3,923, up from 1,444 [DIS_10K_2024-09-28__financial_statements__0029]"], ["Sports", "17,619 [DIS_10K_2024-09-28__financial_statements__0029]", "2,406, down from 2,465 [DIS_10K_2024-09-28__financial_statements__0029]"], ["Experiences", "34,151 [DIS_10K_2024-09-28__financial_statements__0029]", "9,272, up from 8,954 [DIS_10K_2024-09-28__financial_statements__0029]"], ["Total segments", "91,361 [DIS_10K_2024-09-28__financial_statements__0029]", "15,601, up from 12,863 [DIS_10K_2024-09-28__financial_statements__0029]"]]}, "citations": [{"chunk_id": "DIS_10K_2024-09-28__mdna__0003", "claim": "Revenue, net income, EPS and revenue drivers", "quote": "Revenues for fiscal 2024 increased 3%, or $2.5 billion, to $91.4 billion"}, {"chunk_id": "DIS_10K_2024-09-28__mdna__0023", "claim": "Entertainment sub-segment revenue and operating income", "quote": "Direct-to-Consumer | 143 | (2,496) | nm"}, {"chunk_id": "DIS_10K_2024-09-28__mdna__0035", "claim": "DTC revenue and operating income", "quote": "Subscription fees | $ 18,796 | $ 16,420 | 14 %"}, {"chunk_id": "DIS_10K_2024-09-28__mdna__0025", "claim": "Linear Networks decline", "quote": "Affiliate fees | $ 6,872 | $ 7,369 | (7) %"}, {"chunk_i