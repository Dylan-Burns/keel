answer": {"direct_answer": "Microsoft's total revenue for fiscal 2025, the year ended June 30, 2025, was $281,724 million [facts:MSFT:RevenueFromContractWithCustomerExcludingAssessedTax:FY2025]. The 10-K income statement shows the same total revenue of $281,724 million, against $245,122 million for fiscal 2024 [MSFT_10K_2025-06-30__financial_statements__0001]. That is an increase of $36.6 billion or 15%, with growth across each segment [MSFT_10K_2025-06-30__mdna__0013]. Revenue by segment sums to the total: Productivity and Business Processes $120,810 million, Intelligent Cloud $106,265 million, and More Personal Computing $54,649 million [MSFT_10K_2025-06-30__financial_statements__0126].", "company_findings": [{"ticker": "MSFT", "company": "Microsoft Corporation", "findings": [{"point": "Total revenue for fiscal 2025 (year ended June 30, 2025) was $281,724 million.", "citations": ["facts:MSFT:RevenueFromContractWithCustomerExcludingAssessedTax:FY2025", "MSFT_10K_2025-06-30__financial_statements__0001"], "unverified": false}, {"point": "Revenue rose $36.6 billion or 15% from fiscal 2024, with growth across each segment.", "citations": ["MSFT_10K_2025-06-30__mdna__0013"], "unverified": false}, {"point": "Segment revenue was $120,810 million (Productivity and Business Processes), $106,265 million (Intelligent Cloud), and $54,649 million (More Personal Computing), in millions of dollars.", "citations": ["MSFT_10K_2025-06-30__financial_statements__0126"], "unverified": false}]}], "comparison_table": null, "citations": [{"chunk_id": "facts:MSFT:RevenueFromContractWithCustomerExcludingAssessedTax:FY2025", "claim": "Fiscal 2025 revenue was 281,724 USD millions", "quote": "281,724 | USD millions | FY2025 | period end 2025-06-30"}, {"chunk_id": "MSFT_10K_2025-06-30__financial_statements__0001", "claim": "Income statement shows total revenue of $281,724 million vs $245,122 million in fiscal 2024", "quote": "Total revenue | 281,724 | 245,122 | 211,915"}, {"chunk_id": "MSFT_10K_2025-06-30__mdna__0013", "claim": "Revenue increased $36.6 billion or 15% with growth across each segment", "quote": "Revenue increased $36.6 billion or 15% with growth across each of our segments."}, {"chunk_id": "MSFT_10K_2025-06-30__financial_statements__0126", "claim": "Segment revenues sum to the $281,724 million total", "quote": "Total Revenue | $ 281,724 | $ 245,122 | $ 211,915"}], "coverage": {"companies_used": [{"ticker": "MSFT", "forms": ["10-K"], "fiscal_periods": ["FY2025, ended June 30, 2025"]}], "companies_missing": [], "data_as_of": "MSFT 10-K for fiscal 2025, period ended 2025-06-30, filed 2025-07-30"}, "gaps": [], "confidence": "high", "confidence_reason": "The reported fact line and the audited income statement in the fiscal 2025 10-K agree on $281,724 million, and the segment table sums to the same total.", "next_questions": ["How did Microsoft's revenue by segment change from fiscal 2024 to fiscal 2025?", "What was Microsoft's operating income in fiscal 2025?", "What drove Intelligent Cloud revenue growth in fiscal 2025?", "How did Microsoft Cloud revenue and gross margin percentage change in fiscal 2025?"], "refusal": null}, "citations_resolved": [{"chunk_id": "facts:MSFT:RevenueFromContractWithCustomerExcludingAssessedTax:FY2025", "claim": "Fiscal 2025 revenue was 281,724 USD millions", "quote": "281,724 | USD millions | FY2025 | period end 2025-06-30", "ticker": "MSFT", "filing_name": "MSFT 10-K filed 2026-07-29", "section_title": "XBRL company facts", "fiscal_label": "FY2025", "period_end": "2025-06-30", "filing_date": "2026-07-29", "sec_url": "https://www.sec.gov/Archives/edgar/data/789019/000119312526323660/0001193125-26-323660-index.htm", "truncated": false, "quote_mismatch": false, "valid": true, "kind": "fact"}, {"chunk_id": "MSFT_10K_2025-06-30__financial_statements__0001", "claim": "Income statement shows total revenue of $281,724 million vs $245,122 million in fiscal 2024", "quote": "Total revenue | 281,724 | 245,122 | 211,915", "tic