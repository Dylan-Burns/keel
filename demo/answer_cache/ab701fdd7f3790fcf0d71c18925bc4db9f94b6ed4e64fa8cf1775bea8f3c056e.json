 & Co 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/19617/000162828026008131/jpm-20251231.htm", "truncated": false}, {"chunk_id": "BAC_10K_2024-12-31__risk_factors__0060", "ticker": "BAC", "form": "10-K", "fiscal_label": "FY2024", "period_end": "2024-12-31", "section": "risk_factors", "score": 1.4752, "filing_name": "Bank of America Corporation 10-K FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/70858/000007085825000139/bac-20241231.htm", "truncated": false}, {"chunk_id": "BAC_10K_2024-12-31__risk_factors__0056", "ticker": "BAC", "form": "10-K", "fiscal_label": "FY2024", "period_end": "2024-12-31", "section": "risk_factors", "score": 1.4735, "filing_name": "Bank of America Corporation 10-K FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/70858/000007085825000139/bac-20241231.htm", "truncated": false}, {"chunk_id": "BAC_10K_2024-12-31__risk_factors__0061", "ticker": "BAC", "form": "10-K", "fiscal_label": "FY2024", "period_end": "2024-12-31", "section": "risk_factors", "score": 1.4703, "filing_name": "Bank of America Corporation 10-K FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/70858/000007085825000139/bac-20241231.htm", "truncated": false}, {"chunk_id": "BAC_10K_2024-12-31__risk_factors__0057", "ticker": "BAC", "form": "10-K", "fiscal_label": "FY2024", "period_end": "2024-12-31", "section": "risk_factors", "score": 1.4703, "filing_name": "Bank of America Corporation 10-K FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/70858/000007085825000139/bac-20241231.htm", "truncated": false}, {"chunk_id": "BAC_10K_2024-12-31__risk_factors__0077", "ticker": "BAC", "form": "10-K", "fiscal_label": "FY2024", "period_end": "2024-12-31", "section": "risk_factors", "score": 1.4693, "filing_name": "Bank of America Corporation 10-K FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/70858/000007085825000139/bac-20241231.htm", "truncated": false}, {"chunk_id": "BAC_10K_2024-12-31__risk_factors__0050", "ti