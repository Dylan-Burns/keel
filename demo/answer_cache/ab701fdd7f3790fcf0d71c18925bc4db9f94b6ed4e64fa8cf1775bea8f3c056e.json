 "2024-12-31", "section": "risk_factors", "score": 1.4786, "filing_name": "Goldman Sachs Group Inc 10-K FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/886982/000088698225000005/gs-20241231.htm", "truncated": false}, {"chunk_id": "GS_10K_2024-12-31__risk_factors__0007", "ticker": "GS", "form": "10-K", "fiscal_label": "FY2024", "period_end": "2024-12-31", "section": "risk_factors", "score": 1.4742, "filing_name": "Goldman Sachs Group Inc 10-K FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/886982/000088698225000005/gs-20241231.htm", "truncated": false}, {"chunk_id": "GS_10K_2024-12-31__risk_factors__0063", "ticker": "GS", "form": "10-K", "fiscal_label": "FY2024", "period_end": "2024-12-31", "section": "risk_factors", "score": 1.4702, "filing_name": "Goldman Sachs Group Inc 10-K FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/886982/000088698225000005/gs-20241231.htm", "truncated": false}, {"chunk_id": "GS_10K_2024-12-31__risk_factors__0004", "ticker": "GS", "form": "10-K", "fiscal_label": "FY2024", "period_end": "2024-12-31", "section": "risk_factors", "score": 1.4592, "filing_name": "Goldman Sachs Group Inc 10-K FY2024", "sec_url": "https://www.sec.gov/Archives/edgar/data/886982/000088698225000005/gs-20241231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__unknown__0097", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "unknown", "score": 0.6797, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__mdna__0336", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "mdna", "score": 0.7838, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__mdna__0871", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "mdna", "score": 0.7758, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__mdna__0878", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "mdna", "score": 0.7734, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__mdna__0225", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "mdna", "score": 0.7722, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__mdna__0201", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "mdna", "score": 0.7714, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__mdna__0175", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "mdna", "score": 0.7602, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__mdna__0174", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "mdna", "score": 0.7521, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}, {"chunk_id": "MS_10K_2025-12-31__mdna__0181", "ticker": "MS", "form": "10-K", "fiscal_label": "FY2025", "period_end": "2025-12-31", "section": "mdna", "score": 0.75, "filing_name": "Morgan Stanley 10-K FY2025", "sec_url": "https://www.sec.gov/Archives/edgar/data/895421/000089542126000086/ms-20251231.htm", "truncated": false}], "collapsed_near_duplicates": 51, "dropped_candidates": 563, "token_estimate": 31968, "gaps": [], "degraded": []}, "answer": {"direct_answer": "All four banks tie regulatory capital to limits on shareholder distributions, and the filings differ in emphasis. JPMorgan (FY2025, ended December 31, 2025) says a failure to maintain required capital could reduce permitted share repurchases and constrain common dividends [JPM_10K_2025-12-31__risk_factors__0043]. Bank of America (FY2024, ended December 31, 2024) says regulators may require increased capital and liquidity levels, and may change how RWA is calculated [BAC_10K_2024-12-31__risk_factors__0061]. Goldman Sachs (FY2024, ended December 31, 2024) says the SCB has resulted in higher and more volatile Standardized capital ratio requirements, and expects its G-SIB surcharge to rise from 3.0% to 3.5% effective January 1, 2026 [GS_10K_2024-12-31__risk_factors__0064]. Morgan Stanley (FY2025, ended December 31, 2025) points to regulatory constraints or revised capital requirements that may prevent dividends or other capital actions [MS_10K_2025-12-31__unknown__0097], and describes its SCB, set annually by the Federal Reserve's stress test [MS_10K_2025-12-31__mdna__0201]. The filings do not rank these risks.", "company_findings": [{"ticker": "JPM", "company": "JPMorgan Chase & Co", "findings": [{"point": "JPMorgan lists capital risk as the risk that its ability to distribute capital or support business activities could be limited if it does not satisfy regulatory capital requirements.", "citations": ["JPM_10K_2025-12-31__risk_factors__0001"], "unverified": false}, {"point": "Failure to maintain required capital, or use of regulatory buffers, could reduce permitted repurchases, constrain common dividends, or curtail business activities or operations.", "citations": ["JPM_10K_2025-12-31__risk_factors__0043"], "unverified": false}, {"point": "Models not approved by regulators for Basel III RWA calculations could lead to higher capital charges.", "citations": ["JPM_10K_2025-12-31__risk_factors__0071"], "unverified": false}]}, {"ticker": "BAC", "company": "Bank of America Corporation", "findings": [{"point": "Bank of America states that U.S. federal banking agencies may require increased capital and liquidity levels, which could adversely impact the Corporation.", "citations": ["BAC_10K_2024-12-31__risk_factors__0060"], "unverified": false}, {"point": "As a G-SIB it must hold additional buffers (G-SIB surcharge, SCB, countercyclical buffer), and regulators may change TLAC and long-term debt requirements or how capital or RWA is calculated.", "citations": ["BAC_10K_2024-12-31__risk_factors__0061"], "unverified": false}, {"point": "If an insured depository subsidiary fails to maintain well-capitalized status, the Federal Reserve will require an agreement that may restrict dividends and stock repurchases.", "citations": ["BAC_10K_2024-12-31__risk_factors__0061"], "unverified": false}]}, {"ticker": "GS", "company": "Goldman Sachs Group Inc", "findings": [{"point": "The SCB has replaced the capital conservation buffer and resulted in higher and more volatile Standardized capital ratio requirements; failure to comply could limit repurchases, dividends and discretionary compensation payments.", "citations": ["GS_10K_2024-12-31__risk_factors__0064"], "unverified": false}, {"point": "Its G-SIB surcharge is updated annually and is expected to increase from 3.0% to 3.5% effective January 1, 2026.", "citations": ["GS_10K_2024-12-31__risk_factors__0064"], "unverified": false}, {"point": "Dodd-Frank and Basel III have altered its regulatory framework, and it may face higher and more stringent capital requirements from the Basel Committee's finalization of post-crisis reforms.", "citations": ["GS_10K_2024-12-31__risk_factors__0063"], "unverified": false}]}, {"ticker": "MS", "company": "Morgan Stanley", "findings": [{"point": "Morgan Stanley's risk factors say U.S. banking agencies can prohibit or limit dividends or other capital actions, and refer to a risk factor on regulatory constraints or revised capital requirements.", "citations": ["MS_10K_2025-12-31__unknown__0097"], "unverified": false}, {"point": "The Federal Reserve sets an SCB for each large BHC through its annual supervisory stress test, revised each year and taking effect from October 1.", "citations": ["MS_10K_2025-12-31__mdna__0201"], "unverified": false}, {"point": "It must remain well-capitalized to remain an FHC, and must maintain minimum risk-based, leverage-based and TLAC ratios.", "citations": ["MS_10K_2025-12-31__mdna__0175"], "unverified": false}]}], "comparison_table": {"columns": ["Company", "Capital-risk theme described", "Consequence stated"], "rows": [["JPM (FY2025)", "Failure to maintain required level and composition of capital [JPM_10K_2025-12-31__risk_factors__0043]", "Reduced repurchases, constrained dividends, curtailed activities"], ["BAC (FY2024)", "Agencies may require increased capital and liquidity [BAC_10K_2024-12-31__risk_factors__0060]", "Restrictions on dividends and repurchases if not well capitalized [BAC_10K_2024-12-31__risk_factors__0061]"], ["GS (FY2024)", "SCB gives higher, more volatile requirements [GS_10K_2024-12-31__risk_factors__0064]", "Limits on repurchases, dividends, discretionary compensation"], ["MS (FY2025)", "Regulatory constraints or revised capital requirements [MS_10K_2025-12-31__unknown__0097]", "May be prevented from dividends or other capital actions"]]}, "citations": [{"chunk_id": "JPM_10K_2025-12-31__risk_factors__0043", "claim": "JPM capital shortfall could reduce repurchases and constrain dividends", "quote": "reducing the amount of common stock that JPMorgan Chase is permitted to repurchase"}, {"chunk_id": "JPM_10K_2025-12-31__risk_factors__0001", "claim": "JPM summarizes capital risk", "quote": "ability to distribute capital to shareholders or to support its business activities could be limited"}, {"chunk_id": "JPM_10K_2025-12-31__risk_factors__0071", "claim": "Unapproved models could mean higher capital charges", "quote": "it could be subject to higher capital charges"}, {"chunk_id": "BAC_10K_2024-12-31__risk_factors__0060", "claim": "BAC regulators may require increased capital and liquidity", "quote": "U.S. federal banking agencies may require increased capital and liquidity levels"}, {"chunk_id": "BAC_10K_2024-12-31__risk_factors__0061", "claim": "BAC buffers, rule changes and well-capitalized restrictions", "quote": "regulators may change regulatory capital requirements, including total loss-absorbing capacity (TLAC)"}, {"chunk_id": "GS_10K_2024-12-31__risk_factors__0064", "claim": "GS SCB and G-SIB surcharge", "quote": "expected to increase from 3.0% to 3.5%"}, {"chunk_id": "GS_10K_2024-12-31__risk_factors__0063", "claim": "GS faces possibly higher Basel capital requirements", "quote": "may become subject to higher and more stringent capital and other regulatory requirements"}, {"chunk_id": "MS_10K_2025-12-31__unknown__0097", "claim": "MS agencies can limit dividends and capital actions", "quote": "authority, and under certain circumstances the duty, to prohibit or to limit the payment of dividends"}, {"chunk_id": "MS_10K_2025-12-31__mdna__0201", "claim": "MS SCB set by Federal Reserve stress test", "quote": "the Federal Reserve determines an SCB for each large BHC"}, {"chunk_id": "MS_10K_2025-12-31__mdna__0175", "claim": "MS must remain well-capitalized to stay an FHC", "quote": "For us to remain an FHC, we must remain well-capitalized"}], "coverage": {"companies_used": [{"ticker": "JPM", "forms": ["10-K"], "fiscal_periods": ["FY2025, ended December 31, 2025"]}, {"ticker": "BAC", "forms": ["10-K"], "fiscal_periods": ["FY2024, ended De