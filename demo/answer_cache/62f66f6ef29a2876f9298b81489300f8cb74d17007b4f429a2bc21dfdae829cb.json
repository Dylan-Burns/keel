ile Greater China fell 8% [AAPL_10K_2024-09-28__mdna__0002]. The same segment net sales figures appear in the segment note to the financial statements [AAPL_10K_2024-09-28__financial_statements__0077].", "company_findings": [{"ticker": "AAPL", "company": "Apple Inc", "findings": [{"point": "Fiscal 2024 (ended September 28, 2024) net sales: Americas $167,045 million, Europe $101,328 million, Greater China $66,952 million, Japan $25,052 million, Rest of Asia Pacific $30,658 million, total $391,035 million.", "citations": ["AAPL_10K_2024-09-28__mdna__0002"], "unverified": false}, {"point": "The 10-K attributes the Americas increase primarily to higher net sales of Services, and the Greater China decrease primarily to lower net sales of iPhone and iPad.", "citations": ["AAPL_10K_2024-09-28__mdna__0003"], "unverified": false}, {"point": "Segment net sales are identical in the segment note, which also gives segment operating income (e.g., Americas $67,656 million).", "citations": ["AAPL_10K_2024-09-28__financial_statements__0077"], "unverified": false}]}], "comparison_table": {"columns": ["Segment", "Fiscal 2024 net sales ($ millions)", "Fiscal 2023 net sales ($ millions)", "Change"], "rows": [["Americas", "$167,045 [AAPL_10K_2024-09-28__mdna__0002]", "$162,560", "3%"], ["Europe", "$101,328 [AAPL_10K_2024-09-28__mdna__0002]", "$94,294", "7%"], ["Greater China", "$66,952 [AAPL_10K_2024-09-28__mdna__0002]", "$72,559", "(8)%"], ["Japan", "$25,052 [AAPL_10K_2024-09-28__mdna__0002]", "$24,257", "3%"], ["Rest of Asia Pacific", "$30,658 [AAPL_10K_2024-09-28__mdna__0002]", "$29,615", "4%"]]}, "citations": [{"chunk_id": "AAPL_10K_2024-09-28__mdna__0002", "claim": "Fiscal 2024 net sales by reportable segment, with changes versus fiscal 2023", "quote": "Greater China | 66,952 | (8) | % | 72,559"}, {"chunk_id": "AAPL_10K_2024-09-28__financial_statements__0077", "claim": "Segment note confirms segment net sales for fiscal 2024", "quote": "Europe: Net sales | $ 101,328 | $ 94,294 | $ 9