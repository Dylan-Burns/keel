2023", "period_end": "2023-06-30", "section": "mdna", "score": 0.0145, "filing_name": "UnitedHealth Group Inc 10-Q Q2 FY2023", "sec_url": "https://www.sec.gov/Archives/edgar/data/731766/000073176623000053/unh-20230630.htm", "truncated": false}, {"chunk_id": "UNH_10Q_2023-06-30__unknown__0014", "ticker": "UNH", "form": "10-Q", "fiscal_label": "Q2 FY2023", "period_end": "2023-06-30", "section": "unknown", "score": 0.0076, "filing_name": "UnitedHealth Group Inc 10-Q Q2 FY2023", "sec_url": "https://www.sec.gov/Archives/edgar/data/731766/000073176623000053/unh-20230630.htm", "truncated": false}, {"chunk_id": "UNH_10Q_2023-03-31__mdna__0021", "ticker": "UNH", "form": "10-Q", "fiscal_label": "Q1 FY2023", "period_end": "2023-03-31", "section": "mdna", "score": 0.8924, "filing_name": "UnitedHealth Group Inc 10-Q Q1 FY2023", "sec_url": "https://www.sec.gov/Archives/edgar/data/731766/000073176623000029/unh-20230331.htm", "truncated": false}, {"chunk_id": "UNH_10Q_2023-03-31__mdna__0002", "ticker": "UNH", "form": "10-Q", "fiscal_label": "Q1 FY2023", "period_end": "2023-03-31", "section": "mdna", "score": 0.8867, "filing_name": "UnitedHealth Group Inc 10-Q Q1 FY2023", "sec_url": "https://www.sec.gov/Archives/edgar/data/731766/000073176623000029/unh-20230331.htm", "truncated": false}, {"chunk_id": "UNH_10Q_2023-03-31__mdna__0020", "ticker": "UNH", "form": "10-Q", "fiscal_label": "Q1 FY2023", "period_end": "2023-03-31", "section": "mdna", "score": 0.8027, "filing_name": "UnitedHealth Group Inc 10-Q Q1 FY2023", "sec_url": "https://www.sec.gov/Archives/edgar/data/731766/000073176623000029/unh-20230331.htm", "truncated": false}], "collapsed_near_duplicates": 150, "dropped_candidates": 404, "token_estimate": 31922, "gaps": [], "degraded": []}, "answer": {"direct_answer": "UnitedHealth's 10-Q risk factor sections for Q3 FY2023 (ended September 30, 2023), Q3 FY2024 (ended September 30, 2024) and Q3 FY2025 (ended October... see below) each report no material changes to the prior 10-K risk factors [UNH_10Q_2023-09-30__risk_factors__0000] [UNH_10Q_2024-09-30__risk_factors__0000]. The Q3 FY2025 10-Q (ended September 30, 2025) likewise states no material changes from the fiscal 2024 10-K [UNH_10Q_2025-09-30__risk_factors__0000]. The visible changes come from comparing the fiscal 2023 10-K (ended December 31, 2023) with the fiscal 2024 10-K (ended December 31, 2024): the fiscal 2024 cyber risk factor now cites the 2024 Change Healthcare cyberattack and AI/ML-enabled attack techniques [UNH_10K_2024-12-31__risk_factors__0005]. The fiscal 2023 and fiscal 2024 technology risk text is otherwise nearly identical [UNH_10K_2023-12-31__risk_factors__0004] [UNH_10K_2024-12-31__risk_factors__0004]. MD&A forward-looking factor lists show the DOJ item shifting from the risk adjustment submission matter to the DOJ's legal actions concerning Medicare participation by Q3 FY2025 [UNH_10Q_2025-09-30__mdna__0030]. Full fiscal 2022 and complete fiscal 2023/2024 10-K risk sections are not in the context, so a full line-by-line comparison is not possible.", "company_findings": [{"ticker": "UNH", "company": "UnitedHealth Group Inc", "findings": [{"point": "The 10-Q risk factor sections in the context (Q3 FY2023, Q3 FY2024, Q3 FY2025) each state no material changes to the prior 10-K risk factors.", "citations": ["UNH_10Q_2023-09-30__risk_factors__0000", "UNH_10Q_2024-09-30__risk_factors__0000", "UNH_10Q_2025-09-30__risk_factors__0000"], "unverified": false}, {"point": "The fiscal 2024 10-K (ended December 31, 2024) added a specific reference to the 2024 Change Healthcare cyberattack and to AI/ML (including generative AI) making attack techniques more sophisticated.", "citations": ["UNH_10K_2024-12-31__risk_factors__0005"], "unverified": false}, {"point": "MD&A risk-factor lists changed: the DOJ item moved from the risk adjustment submission matter (Q1 FY2024, ended March 31, 2024) to the DOJ's legal actions concerning Medicare participation (Q3 FY2025, ended September 30, 2025), and the South America item changed to the sale of remaining operations.", "citations": ["UNH_10Q_2024-03-31__mdna__0024", "UNH_10Q_2025-09-30__mdna__0030"], "unverified": false}]}], "comparison_table": {"columns": ["Filing", "Risk factor change noted"], "rows": [["Q3 FY2023 10-Q (ended Sep 30, 2023)", "No material changes to 2022 10-K risk factors [UNH_10Q_2023-09-30__risk_factors__0000]"], ["Fiscal 2023 10-K (ended Dec 31, 2023)", "Cyber risk stated generally, without a named incident [UNH_10K_2023-12-31__risk_factors__0004]"], ["Q3 FY2024 10-Q (ended Sep 30, 2024)", "No material changes to 2023 10-K risk factors [UNH_10Q_2024-09-30__risk_factors__0000]"], ["Fiscal 2024 10-K (ended Dec 31, 2024)", "Adds Change Healthcare cyberattack and AI/ML threat language [UNH_10K_2024-12-31__risk_factors__0005]"], ["Q3 FY2025 10-Q (ended Sep 30, 2025)", "No material changes to 2024 10-K risk factors [UNH_10Q_2025-09-30__risk_factors__0000]"]]}, "citations": [{"chunk_id": "UNH_10Q_2023-09-30__risk_factors__0000", "claim": "No material changes, Q3 FY2023", "quote": "There have been no material changes to the risk factors as disclosed in our 2022 10-K."}, {"chunk_id": "UNH_10Q_2024-09-30__risk_factors__0000", "claim": "No material changes, Q3 FY2024", "quote": "There have been no material changes to the risk factors as disclosed in our 2023 10-K."}, {"chunk_id": "UNH_10Q_2025-09-30__risk_factors__0000", "claim": "No material changes, Q3 FY2025", "quote": "There have been no material changes to the risk factors as disclosed in our 2024 10-K."}, {"chunk_id": "UNH_10K_2024-12-31__risk_factors__0005", "claim": "Change Healthcare cyberattack and AI/ML added", "quote": "our Change Healthcare business, which we had recently acquired, was subject to a cyberattack in 2024"}, {"chunk_id": "UNH_10K_2023-12-31__risk_factors__0004", "claim": "Fiscal 2023 cyber language is generic", "quote": "If we or third parties we rely on sustain cyber-attacks or other privacy or data security incidents"