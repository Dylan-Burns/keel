{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(uv *)",
      "Bash(make *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(git for-each-ref *)",
      "Bash(gh auth status *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh workflow *)",
      "Bash(gh release download *)",
      "Bash(gh release view *)",
      "Bash(gh api *)",
      "Bash(docker build *)",
      "Bash(docker compose *)",
      "Bash(docker images *)",
      "Bash(curl *)",
      "Bash(scripts/*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sed -n *)",
      "Bash(awk *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(date *)",
      "Bash(seq *)",
      "Bash(nohup *)",
      "Bash(jq *)",
      "Bash(sha256sum *)",
      "Bash(tar *)",
      "Bash(unzip -l *)",
      "Bash(sleep *)",
      "Bash(test *)",
      "Bash(which *)",
      "Bash(sqlite3 *)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:huggingface.co)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:google.github.io)",
      "WebFetch(domain:docs.railway.com)",
      "WebFetch(domain:motion.dev)",
      "WebFetch(domain:www.sec.gov)",
      "WebFetch(domain:fastapi.tiangolo.com)",
      "WebFetch(domain:docs.pydantic.dev)",
      "WebFetch(domain:sbert.net)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(sudo *)",
      "Bash(cat .env)",
      "Read(./.env)",
      "Edit(./.env)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard_bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/format_on_edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop_check.sh"
          }
        ]
      }
    ]
  }
}
